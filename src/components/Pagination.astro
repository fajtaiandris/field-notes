---
const { previous, next, label, spread } = Astro.props;
---

<nav class="pagination" aria-label="Pages">
  {previous ? (
    <a href={previous} aria-label={spread ? "Previous pages" : "Previous page"}>◀</a>
  ) : (
    <span class="pagination-end" aria-hidden="true">◀</span>
  )}
  <span>{label}</span>
  {next ? (
    <a href={next} aria-label={spread ? "Next pages" : "Next page"}>▶</a>
  ) : (
    <span class="pagination-end" aria-hidden="true">▶</span>
  )}
</nav>
